class FazendaPonto {
  final int? id;
  final String nome;
  final String descricao;
  final double latitude;
  final double longitude;
  final int colorValue;

  FazendaPonto({
    this.id,
    required this.nome,
    required this.descricao,
    required this.latitude,
    required this.longitude,
    required this.colorValue,
  });

  Map<String, dynamic> toMap() {
    return {
      'id': id,
      'nome': nome,
      'descricao': descricao,
      'latitude': latitude,
      'longitude': longitude,
      'colorValue': colorValue,
    };
  }

  factory FazendaPonto.fromMap(Map<String, dynamic> map) {
    return FazendaPonto(
      id: map['id'],
      nome: map['nome'],
      descricao: map['descricao'],
      latitude: map['latitude'],
      longitude: map['longitude'],
      colorValue: map['colorValue'],
    );
  }
}

class FazendaDatabase {
  FazendaDatabase._privateConstructor();
  static final FazendaDatabase instance = FazendaDatabase._privateConstructor();

  static Database? _database;

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDatabase();
    return _database!;
  }

  Future<Database> _initDatabase() async {
    Directory documentsDirectory = await getApplicationDocumentsDirectory();
    String path = '${documentsDirectory.path}/fazenda.db';

    return await openDatabase(
      path,
      version: 1,
      onCreate: _onCreate,
    );
  }

  Future<void> _onCreate(Database db, int version) async {
    await db.execute('''
      CREATE TABLE pontos(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nome TEXT,
        descricao TEXT,
        latitude REAL,
        longitude REAL,
        colorValue INTEGER
      )
    ''');
  }

  Future<int> insertPonto(FazendaPonto ponto) async {
    Database db = await instance.database;
    return await db.insert('pontos', ponto.toMap());
  }

  Future<List<FazendaPonto>> getAllPontos() async {
    Database db = await instance.database;
    final List<Map<String, dynamic>> maps = await db.query('pontos');

    return List.generate(maps.length, (i) {
      return FazendaPonto.fromMap(maps[i]);
    });
  }

  Future<int> updatePonto(FazendaPonto ponto) async {
    Database db = await instance.database;
    return await db.update(
      'pontos',
      ponto.toMap(),
      where: 'id = ?',
      whereArgs: [ponto.id],
    );
  }

  Future<int> deletePonto(int id) async {
    Database db = await instance.database;
    return await db.delete(
      'pontos',
      where: 'id = ?',
      whereArgs: [id],
    );
  }
}

class FazendaMapaScreen extends StatefulWidget {
  const FazendaMapaScreen({super.key});

  @override
  State<FazendaMapaScreen> createState() => _FazendaMapaScreenState();
}

class _FazendaMapaScreenState extends State<FazendaMapaScreen> {
  final MapController _mapController = MapController();
  List<FazendaPonto> _pontos = [];
  LatLng? _currentLocation;

  @override
  void initState() {
    super.initState();
    _carregarPontos();
    _carregarLocalizacaoAtual();
  }

  Future<void> _carregarPontos() async {
    final pontos = await FazendaDatabase.instance.getAllPontos();
    setState(() {
      _pontos = pontos;
    });
  }

  Future<void> _carregarLocalizacaoAtual() async {
    bool serviceEnabled;
    LocationPermission permission;

    serviceEnabled = await Geolocator.isLocationServiceEnabled();
    if (!serviceEnabled) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('Ative a localização do celular para usar o GPS.'),
          ),
        );
      }
      return;
    }

    permission = await Geolocator.checkPermission();
    if (permission == LocationPermission.denied) {
      permission = await Geolocator.requestPermission();
      if (permission == LocationPermission.denied) {
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(
              content: Text('Permissão de localização negada.'),
            ),
          );
        }
        return;
      }
    }

    if (permission == LocationPermission.deniedForever) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              'Acesso à localização foi negado permanentemente. Ative nas configurações.',
            ),
          ),
        );
      }
      return;
    }

    final Position pos = await Geolocator.getCurrentPosition(
      desiredAccuracy: LocationAccuracy.high,
    );

    setState(() {
      _currentLocation = LatLng(pos.latitude, pos.longitude);
    });

    _mapController.move(_currentLocation!, 15.5);
  }

  Future<void> _irParaMinhaLocalizacao() async {
    if (_currentLocation == null) {
      await _carregarLocalizacaoAtual();
      return;
    }

    _mapController.move(_currentLocation!, 15.5);
  }

  void _mostrarDetalhes(FazendaPonto ponto) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(20)),
      ),
      builder: (context) {
        return Padding(
          padding: const EdgeInsets.all(20),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Icon(
                    Icons.location_pin,
                    color: Color(ponto.colorValue),
                    size: 28,
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: Text(
                      ponto.nome,
                      style: const TextStyle(
                        fontSize: 22,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 12),
              Text(
                ponto.descricao,
                style: const TextStyle(fontSize: 16),
              ),
              const SizedBox(height: 16),
              Text(
                'Latitude: ${ponto.latitude.toStringAsFixed(6)}',
                style: const TextStyle(fontSize: 14),
              ),
              Text(
                'Longitude: ${ponto.longitude.toStringAsFixed(6)}',
                style: const TextStyle(fontSize: 14),
              ),
              const SizedBox(height: 20),
              Row(
                children: [
                  Expanded(
                    child: ElevatedButton(
                      onPressed: () async {
                        Navigator.pop(context);
                        await Navigator.push(
                          context,
                          MaterialPageRoute(
                            builder: (_) => AddEditPontoScreen(
                              ponto: ponto,
                            ),
                          ),
                        );
                        _carregarPontos();
                      },
                      child: const Text('Editar'),
                    ),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: OutlinedButton(
                      onPressed: () async {
                        Navigator.pop(context);
                        await FazendaDatabase.instance.deletePonto(ponto.id!);
                        _carregarPontos();
                      },
                      child: const Text('Excluir'),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              Center(
                child: TextButton(
                  onPressed: () => Navigator.pop(context),
                  child: const Text('Fechar'),
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final initialCenter = _currentLocation ?? const LatLng(-15.7939, -47.8828);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Mapa da Fazenda'),
        backgroundColor: Colors.green[700],
        foregroundColor: Colors.white,
      ),
      floatingActionButton: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          FloatingActionButton.extended(
            heroTag: 'gps',
            onPressed: _irParaMinhaLocalizacao,
            icon: const Icon(Icons.my_location),
            label: const Text('Minha localização'),
          ),
          const SizedBox(height: 10),
          FloatingActionButton.extended(
            heroTag: 'novo_ponto',
            onPressed: () async {
              await Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (_) => AddEditPontoScreen(
                    initialLatitude: _currentLocation?.latitude,
                    initialLongitude: _currentLocation?.longitude,
                  ),
                ),
              );
              _carregarPontos();
            },
            icon: const Icon(Icons.add_location_alt),
            label: const Text('Novo ponto'),
          ),
        ],
      ),
      floatingActionButtonLocation: FloatingActionButtonLocation.centerFloat,
      body: FlutterMap(
        mapController: _mapController,
        options: MapOptions(
          initialCenter: initialCenter,
          initialZoom: _currentLocation == null ? 12.0 : 15.5,
        ),
        children: [
          TileLayer(
            urlTemplate: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
            userAgentPackageName: 'com.exemplo.fazenda',
          ),
          MarkerLayer(
            markers: _pontos
                .map(
                  (ponto) => Marker(
                    point: LatLng(ponto.latitude, ponto.longitude),
                    width: 42,
                    height: 42,
                    child: GestureDetector(
                      onTap: () => _mostrarDetalhes(ponto),
                      child: Icon(
                        Icons.location_pin,
                        color: Color(ponto.colorValue),
                        size: 42,
                      ),
                    ),
                  ),
                )
                .toList(),
          ),
        ],
      ),
    );
  }
}

class AddEditPontoScreen extends StatefulWidget {
  final FazendaPonto? ponto;
  final double? initialLatitude;
  final double? initialLongitude;

  const AddEditPontoScreen({
    super.key,
    this.ponto,
    this.initialLatitude,
    this.initialLongitude,
  });

  @override
  State<AddEditPontoScreen> createState() => _AddEditPontoScreenState();
}

class _AddEditPontoScreenState extends State<AddEditPontoScreen> {
  final _formKey = GlobalKey<FormState>();

  late TextEditingController _nomeController;
  late TextEditingController _descricaoController;
  late TextEditingController _latitudeController;
  late TextEditingController _longitudeController;

  Color _selectedColor = Colors.red;

  @override
  void initState() {
    super.initState();

    final ponto = widget.ponto;

    _nomeController = TextEditingController(text: ponto?.nome ?? '');
    _descricaoController = TextEditingController(text: ponto?.descricao ?? '');

    _latitudeController = TextEditingController(
      text: ponto != null
          ? ponto.latitude.toString()
          : (widget.initialLatitude ?? '').toString(),
    );

    _longitudeController = TextEditingController(
      text: ponto != null
          ? ponto.longitude.toString()
          : (widget.initialLongitude ?? '').toString(),
    );

    if (ponto != null) {
      _selectedColor = Color(ponto.colorValue);
    }
  }

  @override
  void dispose() {
    _nomeController.dispose();
    _descricaoController.dispose();
    _latitudeController.dispose();
    _longitudeController.dispose();
    super.dispose();
  }

  Future<void> _salvar() async {
    if (!_formKey.currentState!.validate()) return;

    final ponto = FazendaPonto(
      id: widget.ponto?.id,
      nome: _nomeController.text.trim(),
      descricao: _descricaoController.text.trim(),
      latitude: double.parse(_latitudeController.text),
      longitude: double.parse(_longitudeController.text),
      colorValue: _selectedColor.value,
    );

    if (widget.ponto == null) {
      await FazendaDatabase.instance.insertPonto(ponto);
    } else {
      await FazendaDatabase.instance.updatePonto(ponto);
    }

    if (mounted) Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(widget.ponto == null ? 'Novo ponto' : 'Editar ponto'),
        backgroundColor: Colors.green[700],
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Form(
          key: _formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              TextFormField(
                controller: _nomeController,
                decoration: const InputDecoration(
                  labelText: 'Nome do ponto',
                  border: OutlineInputBorder(),
                ),
                validator: (value) =>
                    value == null || value.trim().isEmpty ? 'Informe o nome' : null,
              ),
              const SizedBox(height: 16),
              TextFormField(
                controller: _descricaoController,
                maxLines: 4,
                decoration: const InputDecoration(
                  labelText: 'Descrição',
                  border: OutlineInputBorder(),
                ),
                validator: (value) =>
                    value == null || value.trim().isEmpty ? 'Informe a descrição' : null,
              ),
              const SizedBox(height: 16),
              TextFormField(
                controller: _latitudeController,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                decoration: const InputDecoration(
                  labelText: 'Latitude',
                  border: OutlineInputBorder(),
                ),
                validator: (value) {
                  if (value == null || value.trim().isEmpty) {
                    return 'Informe a latitude';
                  }
                  final lat = double.tryParse(value);
                  if (lat == null || lat < -90 || lat > 90) {
                    return 'Latitude inválida';
                  }
                  return null;
                },
              ),
              const SizedBox(height: 16),
              TextFormField(
                controller: _longitudeController,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                decoration: const InputDecoration(
                  labelText: 'Longitude',
                  border: OutlineInputBorder(),
                ),
                validator: (value) {
                  if (value == null || value.trim().isEmpty) {
                    return 'Informe a longitude';
                  }
                  final lng = double.tryParse(value);
                  if (lng == null || lng < -180 || lng > 180) {
                    return 'Longitude inválida';
                  }
                  return null;
                },
              ),
              const SizedBox(height: 20),
              const Text(
                'Cor do pino',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.w600),
              ),
              const SizedBox(height: 10),
              DropdownButtonFormField<Color>(
                value: _selectedColor,
                decoration: const InputDecoration(
                  border: OutlineInputBorder(),
                ),
                items: [
                  Colors.red,
                  Colors.green,
                  Colors.blue,
                  Colors.orange,
                  Colors.purple,
                  Colors.brown,
                  Colors.black,
                  Colors.teal,
                ].map((color) {
                  return DropdownMenuItem<Color>(
                    value: color,
                    child: Row(
                      children: [
                        Icon(Icons.location_pin, color: color),
                        const SizedBox(width: 10),
                        Text(colorToName(color)),
                      ],
                    ),
                  );
                }).toList(),
                onChanged: (color) {
                  if (color != null) {
                    setState(() {
                      _selectedColor = color;
                    });
                  }
                },
              ),
              const SizedBox(height: 24),
              ElevatedButton.icon(
                onPressed: _salvar,
                icon: const Icon(Icons.save),
                label: Text(widget.ponto == null ? 'Salvar ponto' : 'Atualizar ponto'),
                style: ElevatedButton.styleFrom(
                  padding: const EdgeInsets.symmetric(vertical: 16),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  String colorToName(Color color) {
    if (color == Colors.red) return 'Vermelho';
    if (color == Colors.green) return 'Verde';
    if (color == Colors.blue) return 'Azul';
    if (color == Colors.orange) return 'Laranja';
    if (color == Colors.purple) return 'Roxo';
    if (color == Colors.brown) return 'Marrom';
    if (color == Colors.black) return 'Preto';
    if (color == Colors.teal) return 'Verde escuro';
    return 'Personalizado';
  }
}